# Copy this file to deploy/k8s/eks/secrets.env and replace every placeholder.
# The destination is Git-ignored. Use shell-compatible KEY=value syntax.
# Keep existing database values unchanged when redeploying against existing PVCs.

POSTGRES_USER=foc
POSTGRES_PASSWORD=replace-with-a-strong-user-db-password
USER_SERVICE_INTERNAL_TOKEN=replace-with-a-long-random-token

SUPPLIER_POSTGRES_DB=supplier_db
SUPPLIER_POSTGRES_USER=supplier_admin
SUPPLIER_POSTGRES_PASSWORD=replace-with-a-strong-supplier-admin-password
SUPPLIER_MIGRATION_PASSWORD=replace-with-a-strong-migration-password
SUPPLIER_RUNTIME_PASSWORD=replace-with-a-strong-runtime-password

ORDER_DB_USER=foc_orders
ORDER_DB_PASSWORD=replace-with-a-strong-order-db-password
CREDIT_DB_USER=foc_credits
CREDIT_DB_PASSWORD=replace-with-a-strong-credit-db-password

NOTIFICATION_DB_USER=foc_notifications
NOTIFICATION_DB_PASSWORD=replace-with-a-strong-notification-db-password
# Select a fixed, reviewed, timezone-aware cutoff; events before it produce no alerts.
NOTIFICATIONS_START_AT=2026-11-11T00:00:00Z

AUTH_TIMEOUT_SECONDS=3
LOG_LEVEL=INFO
INITIAL_CREDIT_ALLOCATION=100
CREDIT_RETRY_BACKOFF_SECONDS=0.5,1,2,4

# Optional administrator bootstrap. Leave all four empty, or set all four.
BOOTSTRAP_ADMIN_NUS_STUDENT_NUMBER=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_DISPLAY_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
