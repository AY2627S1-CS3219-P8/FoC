@startuml
title User Service - Get Basic User Profile

autonumber
hide footbox
skinparam shadowing false
skinparam responseMessageBelowArrow true

actor Client
boundary "Users Router\napp/routes/users.py" as API
control "Authentication\napp/auth.py" as Auth
control "User Operations\napp/services/users.py" as Users

Client -> API: GET /users/{user_id}\nBearer token
activate API

ref over API, Auth
  Authenticate request
  See authorizeProtectedRequest.puml
end ref

alt Authentication fails
  API --> Client: 401 Unauthorized
else Request is authenticated
  API -> Users: get_user_profile(user id)
  activate Users

  alt Target user is missing or inactive
    Users --> API: User not visible
    API --> Client: 404 User not found
  else Active target user exists
    Users --> API: Active user
    API --> Client: 200 OK + display name
  else Service unavailable
    Users --> API: Operation unavailable
    API --> Client: 503 Service Unavailable
  end
  deactivate Users
else Authentication service unavailable
  API --> Client: 503 Service Unavailable
end

deactivate API
@enduml
