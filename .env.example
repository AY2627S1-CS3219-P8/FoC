# ─────────────────────────────────────────────────────────────
# FoC — Friend on Campus · Environment configuration (EXAMPLE)
# ─────────────────────────────────────────────────────────────
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# `.env` is git-ignored — NEVER commit real secrets.
# Any variable read by any service MUST appear here with a safe
# placeholder so teammates know what to set.
#
# This is just an example; you can add more variables as needed.
# ─────────────────────────────────────────────────────────────
# ---- Global -------------------------------------------------
LOG_LEVEL=
# ---- Auth / JWT ---------------------------------------------
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=
JWT_REFRESH_TOKEN_TTL=
# ---- User Database ------------------------------------------
POSTGRES_USER=foc
# Single-quote passwords so Compose preserves `$`, spaces, and `#` literally.
POSTGRES_PASSWORD='change-me-locally'
# Shared only by trusted service containers when calling User Service internal APIs.
USER_SERVICE_INTERNAL_TOKEN='replace-with-a-long-random-token'
# Optional one-shot first administrator bootstrap. Set all four values to
# enable it; leaving all four empty makes the bootstrap job a no-op.
BOOTSTRAP_ADMIN_NUS_STUDENT_NUMBER=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_DISPLAY_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
