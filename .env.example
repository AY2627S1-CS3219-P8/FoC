# ─────────────────────────────────────────────────────────────
# FoC — Friend on Campus · Environment configuration (EXAMPLE)
# ─────────────────────────────────────────────────────────────
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# `.env` is git-ignored — NEVER commit real secrets.
# Any variable read by any service MUST appear here with a safe
# placeholder so teammates know what to set.
#
# This is just an example; you can add more variables as needed.
# ─────────────────────────────────────────────────────────────
# ---- Global -------------------------------------------------
LOG_LEVEL=INFO

# ---- Auth / JWT -----------
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=
JWT_REFRESH_TOKEN_TTL=

# ---- User Database ------------------------------------------
POSTGRES_USER=foc
# Single-quote passwords so Compose preserves `$`, spaces, and `#` literally.
POSTGRES_PASSWORD='change-me-locally'

# ---- Supplier Service (local scaffold examples) ---------------
# Dummy values: replace with deployed addresses/credentials when integrating.
# Export these for local runs; the application does not auto-load .env.
DATABASE_URL=postgresql+psycopg://test_user:test_password@localhost:5432/test_supplier
USER_SERVICE_URL=http://localhost:8000
AUTH_TIMEOUT_SECONDS=3

SUPPLIER_POSTGRES_DB=supplier_db
SUPPLIER_POSTGRES_USER=supplier_admin
SUPPLIER_POSTGRES_PASSWORD=replace_with_a_local_password

# ... Add more variables as needed

# Separate supplier migration and runtime roles; provision with database/bootstrap.sql.
SUPPLIER_MIGRATION_PASSWORD=replace_with_a_migration_password
SUPPLIER_RUNTIME_PASSWORD=replace_with_a_runtime_password
